# ==============================================================================
# Cloudflare Pages 环境变量配置模板
# 在 Cloudflare Dashboard -> Pages -> Settings -> Environment Variables 中配置
# 本地调试时可复制此文件重命名为 .dev.vars
# ==============================================================================

# 【必填项】Google Service Account 服务账号的完整 JSON 凭据字符串
SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}'

# 【推荐项】挂载的总根文件夹 ID
# 在 Google Drive 新建一个总文件夹（如「我的影音库」），将该文件夹 ID 填入此处即可。
# 跨盘技巧：如果你想挂载其他的盘/团队盘/不同账号的文件夹，只需在 Google Drive 网页将目标文件夹「添加快捷方式」放入该总文件夹内，即可原生无缝穿透访问！
ROOT_FOLDER_ID="1-3i7VNCMLtTfkWxWpSemjUIvdwNLCi6l"

# 【选填项】网站自定义标题
SITE_NAME="我的私有云盘"

# ==============================================================================
# Cloudflare KV 配置说明 (可选配，非必填)
# 系统已内置 Google Drive 根文件夹元数据 properties 自动免配持久化！
# 若希望启用 Cloudflare KV 提供全球边缘毫秒级极速读取与备份：
# 1. 在 Cloudflare 控制台 -> Workers & Pages -> KV 中创建命名空间（如 cf-drive-player-kv）
# 2. 在 Pages 项目的 Settings -> Functions -> KV namespace bindings 中添加：
#    - Variable name (变量名): DRIVE_KV
#    - KV namespace (命名空间): 选择您创建的 KV 命名空间
# 3. 本地调试如需测试 KV，可在 .dev.vars 或 wrangler.toml 中配置
# ==============================================================================

