# ==============================================================================
# Cloudflare Pages 环境变量配置模板
# 在 Cloudflare Dashboard -> Pages -> 你的项目 -> Settings -> Environment Variables 中配置
# 本地调试时可复制此文件重命名为 .dev.vars
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google 凭据配置（二选一）：
# ------------------------------------------------------------------------------
# 方式 A：单独配置邮箱与私钥（推荐，简洁明了）
CLIENT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# 方式 B：完整 JSON 凭据字符串（将从 GCP 下载的 JSON 密钥文件全文粘贴入单引号中）
# SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}'

# ------------------------------------------------------------------------------
# 2. 根目录与挂载设置：
# ------------------------------------------------------------------------------
# 【必填/推荐】挂载的 Google Drive 根文件夹 ID
# 在 Google Drive 浏览器地址栏中获取（例如 https://drive.google.com/drive/folders/1-3i7VNCMLtTfkWxWpSemjUIvdwNLCi6l 中的尾部字符串）
ROOT_FOLDER_ID="1-3i7VNCMLtTfkWxWpSemjUIvdwNLCi6l"

# ------------------------------------------------------------------------------
# 3. 安全与权限设置：
# ------------------------------------------------------------------------------
# 【推荐】后台管理员密码（若不设置，系统默认密码为 admin，强烈建议显式配置）
ADMIN_PASSWORD="YourStrongAdminPasswordHere"

# 【推荐】签名加固密钥（用于前台访问令牌及管理员令牌的防篡改签名加盐）
JWT_SECRET="YourRandomSuperSecretKey32CharsOrMore"

# 【选填】前台访客密码保护（true/1 开启；亦可在管理员后台动态开关并设置）
# REQUIRE_ACCESS_PASSWORD="false"
# ACCESS_PASSWORD="VisitorPassword123"

# ------------------------------------------------------------------------------
# 4. 界面个性化：
# ------------------------------------------------------------------------------
# 【选填】站点自定义主标题（亦可在管理员后台动态修改）
SITE_NAME="我的私有云盘"

# ==============================================================================
# Cloudflare KV 配置说明 (可选配，用于毫秒级边缘加速与配置持久化)
#
# 系统已内置 Google Drive 根文件夹元数据 properties 自动免配持久化！
# 若希望启用 Cloudflare KV 提供全球边缘毫秒级极速读取与备份：
# 1. 在 Cloudflare 控制台 -> Workers & Pages -> KV 中创建命名空间（如 cf-drive-player-kv）
# 2. 在 Pages 项目的 Settings -> Functions -> KV namespace bindings 中添加：
#    - Variable name (变量名): DRIVE_KV
#    - KV namespace (命名空间): 选择您创建的 KV 命名空间
# 3. 或直接在 wrangler.toml 中取消注释 [[kv_namespaces]] 配置
# ==============================================================================
